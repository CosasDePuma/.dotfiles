{
    "$schema": "https://opencode.ai/config.json",

    "permission": {
        "bash": {
            "*": "ask",
            "*sh": "deny",
            "doas *": "deny",
            "sh": "deny",
            "su": "deny",
            "sudo *": "deny"
        },
        "edit": "ask",
        "external_directory": "deny",
        "read": {
            "*": "allow",
            "*.cert": "deny",
            "*.crt": "deny",
            "*.env": "deny",
            "*.key": "deny",
            "*.keystore": "deny",
            "*.ovpn": "deny",
            "*.p12": "deny",
            "*.pem": "deny",
            "*.pfx": "deny",
            "*/.git/config": "deny",
            "*/.aws/*": "deny",
            "*/.gnupg/*": "deny",
            "*/.kube/config": "deny",
            "*/.ssh/*": "deny",
            "*docker-compose*.yml": "ask",
            "example.env": "allow"
        },
        "webfetch": "ask"
    },

    "provider": {
        "ollama": {
            "models": {
                "gpt-oss:120b": {
                    "name": "gpt-oss:120b"
                },
                "qwen3-coder-next:q8_0": {
                    "name": "qwen3-coder-next:80b"
                }
            },
            "name": "NTT",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://192.168.213.3:11434/v1"
            }
        }
    },

    "theme": "catppuccin-macchiato"
}
