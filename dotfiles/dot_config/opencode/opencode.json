{
    "$schema": "https://opencode.ai/config.json",

    "permission": {
        "bash": {
            "*": "ask",
            "*sh": "deny",
            "doas *": "deny",
            "sh": "deny",
            "su": "deny",
            "sudo *": "deny"
        },
        "edit": "ask",
        "external_directory": "deny",
        "read": {
            "*": "allow",
            "*.cert": "deny",
            "*.crt": "deny",
            "*.env": "deny",
            "*.key": "deny",
            "*.keystore": "deny",
            "*.ovpn": "deny",
            "*.p12": "deny",
            "*.pem": "deny",
            "*.pfx": "deny",
            "*/.git/config": "deny",
            "*/.aws/*": "deny",
            "*/.gnupg/*": "deny",
            "*/.kube/config": "deny",
            "*/.ssh/*": "deny",
            "*docker-compose*.yml": "ask",
            "example.env": "allow"
        },
        "webfetch": "allow"
    },
    "theme": "catppuccin-macchiato"
}
